---------------------------------------------------------------
-- Create and Use the Database
---------------------------------------------------------------
IF DB_ID('OnlineMedicalManagementSystem') IS NULL
    CREATE DATABASE OnlineMedicalManagementSystem;
GO

USE OnlineMedicalManagementSystem;
GO

---------------------------------------------------------------
-- Create Tables
---------------------------------------------------------------

-- Roles
IF OBJECT_ID('roles', 'U') IS NOT NULL DROP TABLE roles;
CREATE TABLE roles (
    id INT PRIMARY KEY IDENTITY(1,1),
    role_name VARCHAR(50) NOT NULL UNIQUE
);

-- Persons
IF OBJECT_ID('persons', 'U') IS NOT NULL DROP TABLE persons;
CREATE TABLE persons (
    id INT PRIMARY KEY IDENTITY(1,1), 
    name VARCHAR(100) NOT NULL,
    contact_number VARCHAR(15),
    email VARCHAR(100),
    address TEXT
);

-- Users
IF OBJECT_ID('users', 'U') IS NOT NULL DROP TABLE users;
CREATE TABLE users (
    id INT PRIMARY KEY IDENTITY(1,1),
    username VARCHAR(100) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    role_id INT NOT NULL,
    person_id INT NOT NULL,
    FOREIGN KEY (role_id) REFERENCES roles(id),
    FOREIGN KEY (person_id) REFERENCES persons(id),
    CONSTRAINT unique_person_role UNIQUE (person_id, role_id)
);

-- Doctors
IF OBJECT_ID('doctors', 'U') IS NOT NULL DROP TABLE doctors;
CREATE TABLE doctors (
    id INT IDENTITY(1,1) PRIMARY KEY,
    person_id INT NOT NULL,
    specialization VARCHAR(100),
    FOREIGN KEY (person_id) REFERENCES persons(id) ON DELETE CASCADE
);

-- Insurance Policies
IF OBJECT_ID('insurance_policies', 'U') IS NOT NULL DROP TABLE insurance_policies;
CREATE TABLE insurance_policies (
    id INT PRIMARY KEY IDENTITY(1,1),
    name VARCHAR(100) NOT NULL,
    coverage_amount DECIMAL(10, 2) NOT NULL,
    premium DECIMAL(10, 2) NOT NULL,
    description VARCHAR(MAX)
);

-- Patients
IF OBJECT_ID('patients', 'U') IS NOT NULL DROP TABLE patients;
CREATE TABLE patients (
    id INT PRIMARY KEY IDENTITY (1,1),
    person_id INT NOT NULL,
    policy_id INT NOT NULL,
    medical_history TEXT,
    date_of_birth DATE,
    FOREIGN KEY (person_id) REFERENCES persons(id) ON DELETE CASCADE,
    FOREIGN KEY (policy_id) REFERENCES insurance_policies(id)
);

-- Appointments
IF OBJECT_ID('appointments', 'U') IS NOT NULL DROP TABLE appointments;
CREATE TABLE appointments (
    id INT IDENTITY(1,1) PRIMARY KEY,
    patient_id INT NOT NULL,
    doctor_id INT NOT NULL,
    time_slot VARCHAR(50) NOT NULL,
    date DATE NOT NULL,
    status VARCHAR(20) CHECK (status IN ('Pending', 'Approved', 'Rejected')) NOT NULL DEFAULT 'Pending',
    FOREIGN KEY (patient_id) REFERENCES patients(id),
    FOREIGN KEY (doctor_id) REFERENCES doctors(id),
    created_at DATETIME DEFAULT GETDATE(),
    updated_at DATETIME DEFAULT GETDATE()
);

-- Medical Records
IF OBJECT_ID('medical_records', 'U') IS NOT NULL DROP TABLE medical_records;
CREATE TABLE medical_records (
    id INT IDENTITY(1,1) PRIMARY KEY,
    patient_id INT NOT NULL,
    appointment_id INT NULL,
    diagnosis TEXT NOT NULL,
    treatment TEXT NOT NULL,
    notes TEXT,
    created_date DATETIME DEFAULT GETDATE(),
    FOREIGN KEY (patient_id) REFERENCES patients(id),
    FOREIGN KEY (appointment_id) REFERENCES appointments(id)
);

-- Schedules
IF OBJECT_ID('schedules', 'U') IS NOT NULL DROP TABLE schedules;
CREATE TABLE schedules (
    id INT IDENTITY(1,1) PRIMARY KEY,
    doctor_id INT NOT NULL,
    time_slot VARCHAR(50) NOT NULL,
    date DATE Not NULL,
    status VARCHAR(20) CHECK (status IN ('Available', 'TBD', 'Unavailable','Booked')) NOT NULL DEFAULT 'Available',
    FOREIGN KEY (doctor_id) REFERENCES doctors(id)
);

-- Patient History
IF OBJECT_ID('patient_history', 'U') IS NOT NULL DROP TABLE patient_history;
CREATE TABLE patient_history (
    id INT IDENTITY(1,1) PRIMARY KEY,
    patient_id INT NOT NULL,
    date DATE NOT NULL,
    diagnosis VARCHAR(255) NOT NULL,
    treatment TEXT NOT NULL,
    FOREIGN KEY (patient_id) REFERENCES patients(id)
);

-- Lab Tests
IF OBJECT_ID('lab_tests', 'U') IS NOT NULL DROP TABLE lab_tests;
CREATE TABLE lab_tests (
    id INT PRIMARY KEY IDENTITY(1,1),
    name VARCHAR(100) NOT NULL,
    description TEXT,
    cost DECIMAL(10, 2) NOT NULL
);

-- Test Requests
IF OBJECT_ID('test_requests', 'U') IS NOT NULL DROP TABLE test_requests;
CREATE TABLE test_requests (
    id INT PRIMARY KEY IDENTITY(1,1),
    patient_id INT NOT NULL,
    doctor_id INT,
    lab_test_id INT NOT NULL,
    request_date DATETIME DEFAULT GETDATE(),
    manager_id INT,
    technician_id INT,
    status VARCHAR(50) DEFAULT 'Created', 
    FOREIGN KEY (patient_id) REFERENCES patients(id),
    FOREIGN KEY (doctor_id) REFERENCES doctors(id),
    FOREIGN KEY (lab_test_id) REFERENCES lab_tests(id),
    FOREIGN KEY (manager_id) REFERENCES users(id),
    FOREIGN KEY (technician_id) REFERENCES users(id)
);

-- Lab Reports
IF OBJECT_ID('lab_reports', 'U') IS NOT NULL DROP TABLE lab_reports;
CREATE TABLE lab_reports (
    id INT PRIMARY KEY IDENTITY(1,1),
    test_request_id INT NOT NULL,
    lab_technician_id INT NOT NULL,
    result TEXT NOT NULL,
    generated_date DATETIME DEFAULT GETDATE(),
    FOREIGN KEY (test_request_id) REFERENCES test_requests(id) ON DELETE CASCADE,
    FOREIGN KEY (lab_technician_id) REFERENCES users(id)
);

-- Insurance Claims
IF OBJECT_ID('insurance_claims', 'U') IS NOT NULL DROP TABLE insurance_claims;
CREATE TABLE insurance_claims (
    id INT PRIMARY KEY IDENTITY(1,1),
    patient_id INT NOT NULL,
    policy_id INT NOT NULL,
    claim_date DATETIME DEFAULT GETDATE(),
    claim_amount DECIMAL(10, 2) NOT NULL,
    status VARCHAR(20) DEFAULT 'Pending',
    remarks TEXT,
    assigned_manager_id INT,
    FOREIGN KEY (patient_id) REFERENCES patients(id) ON DELETE CASCADE,
    FOREIGN KEY (policy_id) REFERENCES insurance_policies(id),
    FOREIGN KEY (assigned_manager_id) REFERENCES users(id)
);

-- Medicines
IF OBJECT_ID('medicines', 'U') IS NOT NULL DROP TABLE medicines;
CREATE TABLE medicines (
    id INT PRIMARY KEY IDENTITY(1,1),
    name VARCHAR(100) NOT NULL,
    description TEXT,
    price DECIMAL(10, 2) NOT NULL,
    quantity_in_stock INT NOT NULL,
    reorder_level INT NOT NULL,
    supplier VARCHAR(100),
    expiry_date DATE
);

IF OBJECT_ID('prescriptions', 'U') IS NOT NULL DROP TABLE pharmacy_prescriptions;
CREATE TABLE prescriptions (
    id INT PRIMARY KEY IDENTITY(1,1),
    patient_id INT NOT NULL,
    doctor_id INT NOT NULL,
    pharmacy_manager_id INT NOT NULL,
    date_requested DATE NOT NULL,
    status VARCHAR(100) DEFAULT 'Pending',
    payment_status VARCHAR(100) DEFAULT 'Pending',
    FOREIGN KEY (patient_id) REFERENCES patients(id),
    FOREIGN KEY (doctor_id) REFERENCES doctors(id),
    FOREIGN KEY (pharmacy_manager_id) REFERENCES users(id)
);

IF OBJECT_ID('prescription_assignments', 'U') IS NOT NULL DROP TABLE prescription_assignments;
CREATE TABLE prescription_assignments (
    id INT PRIMARY KEY IDENTITY(1,1),
    prescription_id INT NOT NULL,
    pharmacist_id INT NOT NULL,
    assigned_date DATE NOT NULL,
    date_fulfilled DATE,
    status VARCHAR(20) DEFAULT 'Assigned',
    FOREIGN KEY (prescription_id) REFERENCES prescriptions(id),
    FOREIGN KEY (pharmacist_id) REFERENCES users(id)
);

IF OBJECT_ID('prescription_medicines', 'U') IS NOT NULL DROP TABLE prescription_medicines;
CREATE TABLE prescription_medicines (
    id INT PRIMARY KEY IDENTITY(1,1),
    prescription_id INT NOT NULL,
    medicine_id INT NOT NULL,
    quantity INT NOT NULL,
    FOREIGN KEY (prescription_id) REFERENCES prescriptions(id),
    FOREIGN KEY (medicine_id) REFERENCES medicines(id)
);

IF OBJECT_ID('medicine_orders', 'U') IS NOT NULL DROP TABLE medicine_orders;
CREATE TABLE medicine_orders (
    id INT PRIMARY KEY IDENTITY(1,1),
    medicine_id INT NOT NULL,
    quantity INT NOT NULL,
    user_id INT NOT NULL,
    order_date DATE NOT NULL,
    status VARCHAR(20) DEFAULT 'Pending',
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (medicine_id) REFERENCES medicines(id)
);

IF OBJECT_ID('PrescriptionBilling', 'U') IS NOT NULL DROP TABLE PrescriptionBilling;
CREATE TABLE PrescriptionBilling (
    id INT PRIMARY KEY IDENTITY(1,1),
    prescription_id INT NOT NULL,
    medicine_id INT NOT NULL,
    quantity INT NOT NULL,
    price DECIMAL(10, 2) NOT NULL,
    total_amount DECIMAL(10, 2),
    bill_date DATE NOT NULL,
    FOREIGN KEY (prescription_id) REFERENCES prescriptions(id),
    FOREIGN KEY (medicine_id) REFERENCES medicines(id)
);

-- Chat Sessions and Messages
IF OBJECT_ID('chat_sessions', 'U') IS NOT NULL DROP TABLE chat_sessions;
CREATE TABLE chat_sessions (
    session_id INT IDENTITY(1,1) PRIMARY KEY,
    patient_id INT NOT NULL,
    agent_id INT NOT NULL,
    status VARCHAR(20) CHECK (status IN ('Open', 'Closed')) DEFAULT 'Open',
    created_at DATETIME DEFAULT GETDATE(),
    closed_at DATETIME,
    FOREIGN KEY (patient_id) REFERENCES patients(id),
    FOREIGN KEY (agent_id) REFERENCES users(id)
);

IF OBJECT_ID('chat_messages', 'U') IS NOT NULL DROP TABLE chat_messages;
CREATE TABLE chat_messages (
    message_id INT IDENTITY(1,1) PRIMARY KEY,
    session_id INT NOT NULL,
    sender_id INT NOT NULL,
    message_text TEXT NOT NULL,
    timestamp DATETIME DEFAULT GETDATE(),
    message_type VARCHAR(20) CHECK (message_type IN ('Text', 'Image', 'File')) DEFAULT 'Text',
    FOREIGN KEY (session_id) REFERENCES chat_sessions(session_id),
    FOREIGN KEY (sender_id) REFERENCES users(id)
);

IF OBJECT_ID('predefined_questions', 'U') IS NOT NULL DROP TABLE predefined_questions;
CREATE TABLE predefined_questions (
    question_id INT IDENTITY(1,1) PRIMARY KEY,
    question_text VARCHAR(255) NOT NULL,
    response_text TEXT NOT NULL
);

